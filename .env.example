# [TR] Bu dosyayi ".env" adiyla kopyalayip kendi degerlerinizi girin.
# [EN] Copy this file as ".env" and fill in your own values.

# [TR] Telegram bildirimleri (bos birakilirsa Telegram devre disi kalir)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# [TR] Discord Webhook bildirimleri (bos birakilirsa Discord devre disi kalir)
DISCORD_WEBHOOK_URL=

# [TR] PostgreSQL/Supabase baglanti adresi.
#      BOS birakilirsa proje klasorunde yerel SQLite (ram_tracker.db) kullanilir.
DB_URL=

# [TR] ALL = bot + dashboard | BOT_ONLY = sadece bot | WEB_ONLY = sadece dashboard
RUN_MODE=ALL

# ---------------------------------------------------------------------------
# BUTCE / BUDGET
# ---------------------------------------------------------------------------
# [TR] Urun basina ust fiyat (TL). Bunun ustundeki urunler icin bildirim gelmez, yeni urun olarak eklenmez.
#      (HEDEF_FIYAT eski isimdir; BUTCE yoksa o kullanilir.)
BUTCE=20000
# [TR] Kategoriye ozel butce (bos = BUTCE)
BUTCE_RAM=
BUTCE_SSD=
BUTCE_ANAKART=
# [TR] Fiyata gore sirali sitelerde taramanin butcenin yuzde kac ustune kadar surecegi
BUTCE_PAYI_YUZDE=15
# [TR] Base fiyata gore yuzde kac dususte "BUYUK INDIRIM" bildirimi atilsin
INDIRIM_YUZDESI=15
# [TR] Stok disi kalan urun en az bu kadar dakika sonra donerse "STOGA GIRDI" bildirimi (0 = kapali)
STOK_BILDIRIM_DAKIKA=60

# ---------------------------------------------------------------------------
# KATEGORI VE SITE SECIMI / CATEGORY AND SITE SELECTION
# ---------------------------------------------------------------------------
# [TR] Takip edilecek kategoriler: ram, ssd, anakart (bos = hepsi)
AKTIF_KATEGORILER=ram,ssd,anakart
# [TR] Kapatilacak siteler (virgulle). Ornek: amazon,akakce
#      Siteler: vatan, sinerji, incehesap, tebilon, itopya, gaming, gamegaraj, teknosa, mediamarkt,
#               amazon, hepsiburada, trendyol, n11, akakce
DEVRE_DISI_SITELER=
# [TR] Doluysa SADECE bu siteler taranir. Ornek: vatan,itopya,incehesap
SADECE_SITELER=
# [TR] SODIMM / notebook RAM'leri takip etme (1 = ele)
NOTEBOOK_RAM_HARIC=0

# ---------------------------------------------------------------------------
# TARAMA SIKLIGI VE PERFORMANS / SCAN FREQUENCY AND PERFORMANCE
#   (en iyi degerler icin: python benchmark.py  /  python benchmark.py --canli)
# ---------------------------------------------------------------------------
# [TR] Uzman siteler (Vatan, Itopya...) kac saniyede bir taransin
KONTROL_SIKLIGI_SANIYE=120
# [TR] Pazar yerleri ve Akakce kac saniyede bir taransin (engel riski nedeniyle daha seyrek)
PAZARYERI_SIKLIGI_SANIYE=600
# [TR] Toplam ayni anda HTTP istegi (0 = otomatik: CPU cekirdegi x 4, 8..32)
MAX_ESZAMANLI_ISTEK=0
# [TR] Tek siteye ayni anda en fazla istek (2 onerilir; artirmak ban riskini artirir)
SITE_BASINA_ESZAMANLI=2
# [TR] Ayni siteye art arda iki istek arasi en kisa sure (saniye)
SITE_ISTEK_ARALIGI_SANIYE=0.75
# [TR] HTML ayristirma surec sayisi (-1 = otomatik: cekirdek-1, en fazla 4; 0 = ana surecte)
PARSE_ISCI_SAYISI=-1
# [TR] Fiyata gore sirali sitelerde bir kategoride en fazla kac sayfa / pazar yerlerinde kac sayfa
MAX_SAYFA=15
PAZARYERI_MAX_SAYFA=3
# [TR] 403/429 alan site kac saniye dinlendirilsin (ust uste engelde ikiye katlanir)
ENGEL_BEKLEME_SANIYE=600
ISTEK_ZAMAN_ASIMI=20
# [TR] curl_cffi tarayici taklidi (chrome = desteklenen en yeni Chrome)
IMPERSONATE=chrome

# [TR] Tebilon icin Cloudflare cerezi. Su an gerekmiyor; loglarda "Tebilon HATA: 403" gorurseniz
#      tarayicinizdan cerez + user-agent kopyalayip buraya yazin.
TEBILON_COOKIE=
TEBILON_USER_AGENT=
